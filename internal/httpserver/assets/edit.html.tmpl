<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Name}} · mdgen</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header>
  <h1>{{.Name}}</h1>
  <div class="actions">
    <span id="status"></span>
    <button id="save">Save</button>
  </div>
</header>
<main>
  <textarea id="editor" spellcheck="false">{{.Content}}</textarea>
  <div id="preview"></div>
</main>
<script src="/static/app.js" data-name="{{.Name}}"></script>
</body>
</html>
